# Copy to .env (repo root for Docker, or backend/.env for local dev) and fill in.
# Leave both keys empty to run in demo mode with generated data.

# Google AI Studio key - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apify API token - https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Actors (override if you prefer other scrapers; normalisers are tolerant of field names)
APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
APIFY_META_ACTOR=curious_coder~facebook-ads-library-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
META_AD_COUNTRY=IN

# Force demo data even when keys are set (true/false). Defaults to true when a key is missing.
# MOCK_MODE=false
# Simulate a source outage in demo mode: instagram, meta or tiktok
# MOCK_FAIL_SOURCE=

# Pipeline tuning
MIN_PER_SOURCE=20
MATCH_THRESHOLD=55
MAX_EXPANSION_ROUNDS=5
MAX_VISION_CANDIDATES=60
SCORE_BATCH_SIZE=8
PHASH_MAX_DISTANCE=6
SOURCE_TIMEOUT_MS=240000
SOURCE_RETRIES=2
JOB_CONCURRENCY=2
SEARCHES_PER_MINUTE=10

# Caching (hours)
PRODUCT_CACHE_TTL_H=168
COLLECTOR_CACHE_TTL_H=6

PORT=4000
DB_PATH=./data/pvd.sqlite
LOG_LEVEL=info
CORS_ORIGIN=*
